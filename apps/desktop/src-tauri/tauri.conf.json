{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "LumiaTool",
    "mainBinaryName": "lumiatool",
    "version": "../../../package.json",
    "identifier": "com.lumiaqian.lumiatool",
    "build": {
        "beforeDevCommand": "pnpm --filter lumiatool-desktop run dev:ui",
        "beforeBuildCommand": "pnpm --filter lumiatool-desktop run build:ui",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "LumiaTool",
                "width": 1100,
                "height": 720,
                "minWidth": 860,
                "minHeight": 600,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "hiddenTitle": true,
                "titleBarStyle": "Overlay",
                "trafficLightPosition": { "x": 16, "y": 18 },
                "useHttpsScheme": true
            }
        ],
        "security": {
            "capabilities": ["main-capability"],
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            },
            "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4OEVBNjVBMTUyQ0I4NjEKUldSaHVDd1ZXcWFPK0xDNEwybnNuQnRMN2ZWeElOZjNZckYyNEl6WHhrQkFkZDBaREFxckl3UDAK",
            "endpoints": ["https://github.com/Lumiaqian/LumiaTool/releases/latest/download/latest.json"],
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "bundle": {
        "active": true,
        "category": "DeveloperTool",
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "macOS": {
            "minimumSystemVersion": "11.0"
        },
        "longDescription": "基于 React 与 Tauri 的跨平台桌面开发工具箱"
    }
}
